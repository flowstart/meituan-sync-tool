{
  "name": "meituan-sync-tool",
  "version": "1.0.0",
  "description": "美团同步工具 - 饿了么到牵牛花库存同步",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --win --x64",
    "build:mac": "electron-builder --mac --x64"
  },
  "keywords": [
    "meituan",
    "eleme",
    "qianniuhua",
    "sync"
  ],
  "author": "Your Name",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "electron-rebuild": "^3.2.9"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "xlsx": "^0.18.5"
  },
  "build": {
    "appId": "com.meituan.sync",
    "productName": "美团同步工具",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity"
    },
    "extraResources": [
      {
        "from": "../backend/dist/",
        "to": "backend/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "files": [
      "**/*",
      "!node_modules",
      "!src"
    ]
  }
}
